@{
    ViewData["Title"] = "Something went wrong";
    int code = ViewBag.Code ?? 500;
}

<div class="text-center py-5">
    @if (code == 404)
    {
        <h1 class="display-4">404</h1>
        <p class="lead">We could not find what you were looking for.</p>
    }
    else
    {
        <h1 class="display-4">Oops</h1>
        <p class="lead">Something unexpected happened. Please try again.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>