@model portfolio.Models.Project
@{
    ViewData["Title"] = "Delete Project";
}

<h1>Delete Project</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<p>Delete <strong>@Model.Title</strong> and its @Model.ImageCount image(s)?</p>

<form asp-action="Delete" asp-route-id="@Model.ProjectId" method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>