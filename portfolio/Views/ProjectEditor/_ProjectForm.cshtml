@model portfolio.Models.Project

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="ProjectId" />

<div class="mb-3">
    <label asp-for="CourseId" class="form-label"></label>
    <select asp-for="CourseId" asp-items="@((List<SelectListItem>)ViewBag.Courses)" class="form-select">
        <option value="0">-- Choose a course --</option>
    </select>
    <span asp-validation-for="CourseId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>
<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="VideoUrl" class="form-label"></label>
        <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
        <span asp-validation-for="VideoUrl" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="CompletedOn" class="form-label"></label>
        <input asp-for="CompletedOn" class="form-control" />
    </div>
</div>
<div class="mb-3">
    <label asp-for="ImageUrls" class="form-label"></label>
    <textarea asp-for="ImageUrls" class="form-control" rows="6"
              placeholder="https://example.com/one.jpg&#10;https://example.com/two.png"></textarea>
    <div class="form-text">Paste public image links ending in .jpg, .jpeg, .png, .gif or .webp. The project and all its images are saved together, or not at all.</div>
    <span id="imageUrlsError" asp-validation-for="ImageUrls" class="text-danger"></span>
</div>

<script>
    // Browser-side check of each image URL, line by line (the server checks again).
    document.addEventListener('DOMContentLoaded', function () {
        var box = document.getElementById('ImageUrls');
        if (!box) return;
        var form = box.closest('form');
        var msg = document.getElementById('imageUrlsError');
        var rx = new RegExp(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(portfolio.Validation.ImageUrlRules.Pattern)), 'i');

        form.addEventListener('submit', function (e) {
            var lines = box.value.split(/\r?\n/);
            for (var i = 0; i < lines.length; i++) {
                var line = lines[i].trim();
                if (line !== '' && !rx.test(line)) {
                    e.preventDefault();
                    msg.textContent = 'Line ' + (i + 1) + ' is not a valid image URL. It must start with http:// or https:// and end in .jpg, .jpeg, .png, .gif or .webp.';
                    box.focus();
                    return;
                }
            }
            msg.textContent = '';
        });
    });
</script>